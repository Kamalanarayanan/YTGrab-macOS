# macOS
.DS_Store

# Xcode user state and build output
DerivedData/
build/
*.xcuserstate
xcuserdata/

# Distribution files belong in GitHub Releases
*.app
*.dmg
*.pkg

# Local archives and backups
Backups/
*.zip

# Temporary files
*.tmp
*.log

# Embedded tools are downloaded and made universal by Scripts/fetch-tools.sh
# (run automatically by Xcode). Universal FFmpeg and Deno are larger than
# GitHub's 100 MB file limit, so they are never committed.
YTGrab/Tools/*
!YTGrab/Tools/.gitkeep
.tools-cache/
