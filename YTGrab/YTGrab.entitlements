<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The sandbox is off deliberately. YTGrab installs its embedded yt-dlp,
	  FFmpeg and Deno into Application Support, keeps yt-dlp and Deno updated
	  there, and launches them as child processes. A sandboxed app cannot
	  execute binaries it downloaded or wrote itself.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<key>com.apple.security.network.client</key>
	<true/>

	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
